# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Vercel Postgres pooled URL recommended).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Canonical origin of the deployed site, no trailing slash.
# Used for WebAuthn RP ID, CSRF origin checks and absolute URLs.
# For local development use http://localhost:3000
APP_ORIGIN="https://www.example.org"

# 32+ random bytes, base64. Signs short-lived WebAuthn challenge cookies.
#   openssl rand -base64 32   (or)   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# One-time bootstrap secret for enrolling the FIRST administrator passkey at
# /admin/setup. 32+ random characters. Remove/rotate after the owner enrolls.
ADMIN_SETUP_TOKEN=""

# Random salt used to pseudonymise IP addresses for rate limiting
# (raw IPs are never stored — DPDP data minimisation).
RATE_LIMIT_SALT=""

# ── Optional ────────────────────────────────────────────────────────────────
# Vercel Blob read-write token — enables image uploads in the admin panel.
# Without it the site uses its built-in artwork and image uploads are disabled.
BLOB_READ_WRITE_TOKEN=""
